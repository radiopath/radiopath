# Local development settings, make dev copies this to .env on first start. Every variable is documented in docs/reference/configuration.md.

DATABASE_URL=postgres://radiopath:radiopath@localhost:5432/radiopath
RADIOPATH_LISTEN=:8080
RADIOPATH_METRICS_LISTEN=:9090
RADIOPATH_LOG_LEVEL=info
RADIOPATH_REGISTRATION=true
RADIOPATH_BASE_URL=http://localhost:5173
RADIOPATH_TRUST_PROXY=false
RADIOPATH_WORKERS=1

# Mails go to Mailpit (http://localhost:8025), started by make dev
RADIOPATH_SMTP_HOST=localhost
RADIOPATH_SMTP_PORT=1025
RADIOPATH_SMTP_STARTTLS=false
RADIOPATH_MAIL_FROM=radiopath@localhost

# Local development only; in production use a secret from: openssl rand -base64 32
RADIOPATH_ADMIN_TOKEN=dev-admin-token-dev-admin-token-dev

# Cloned from https://github.com/radiopath/testfiles by make dev, covers N47E009 only
RADIOPATH_DATASET_DIR=tmp/testfiles
#RADIOPATH_DATASET_S3_ENDPOINT=https://s3.example.org
#RADIOPATH_DATASET_S3_BUCKET=radiopath-datasets
#RADIOPATH_DATASET_S3_REGION=us-east-1
#RADIOPATH_DATASET_S3_ACCESS_KEY=
#RADIOPATH_DATASET_S3_SECRET_KEY=
#RADIOPATH_DATASET_DEM=srtm1
#RADIOPATH_DATASET_CANOPY=canopy1
# ITU data of the HF model, fetched into tmp/testfiles/hf1 by scripts/fetch-hf-data.sh
#RADIOPATH_DATASET_HF=hf1
RADIOPATH_DEM_CACHE_TILES=8

RADIOPATH_REDIS_URL=redis://localhost:6380/0
RADIOPATH_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
RADIOPATH_TILE_TTL=720h
RADIOPATH_TILE_MISSES_PER_IP=300
