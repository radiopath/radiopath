# Copy to .env for local development (make run loads it). Every variable is documented in README.md, section Configuration.

DATABASE_URL=postgres://radiopath:radiopath@localhost:5432/radiopath
RADIOPATH_LISTEN=:8080
RADIOPATH_METRICS_LISTEN=:9090
RADIOPATH_LOG_LEVEL=info
RADIOPATH_REGISTRATION=false
RADIOPATH_BASE_URL=http://localhost:8080
RADIOPATH_TRUST_PROXY=false
RADIOPATH_WORKERS=1

#RADIOPATH_SMTP_HOST=mail.example.org
#RADIOPATH_SMTP_PORT=587
#RADIOPATH_SMTP_STARTTLS=true
#RADIOPATH_SMTP_USER=
#RADIOPATH_SMTP_PASSWORD=
#RADIOPATH_MAIL_FROM=radiopath@example.org

# openssl rand -base64 32
#RADIOPATH_ADMIN_TOKEN=

RADIOPATH_DEM_DIR=./dem
RADIOPATH_DEM_CACHE_TILES=8
#RADIOPATH_DEM_S3_ENDPOINT=https://s3.example.org
#RADIOPATH_DEM_S3_BUCKET=radiopath-dem
#RADIOPATH_DEM_S3_PREFIX=srtm1/
#RADIOPATH_DEM_S3_REGION=us-east-1
#RADIOPATH_DEM_S3_ACCESS_KEY=
#RADIOPATH_DEM_S3_SECRET_KEY=
#RADIOPATH_CANOPY_DIR=./canopy
#RADIOPATH_CANOPY_S3_PREFIX=canopy1/

RADIOPATH_REDIS_URL=redis://localhost:6380/0
RADIOPATH_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
RADIOPATH_TILE_TTL=720h
